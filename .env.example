# ── LioGames Distribution Hub ────────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения. .env в .gitignore —
# НИКОГДА не коммитьте реальные секреты.

# Базовый URL API поставщика.
LIOG_BASE_URL=https://distribution.liogames.com/api/v1

# Идентификатор аккаунта (НЕ секрет, но держим здесь).
LIOG_MEMBER_CODE=M2609247OQFNWJJ8W

# Секрет подписи HMAC-SHA256. ОБЯЗАТЕЛЬНО храните только тут, пусто в репозитории.
LIOG_SECRET=

# Необязательный scoped-ключ lk_... (тогда подпись считается его секретом).
# LIOG_KEY_ID=

# Режим sandbox поставщика (1/0). Sandbox не выдаёт реальные коды.
LIOG_SANDBOX=0

# Локальный mock-режим клиента (1/0) — работает без сети, для разработки/тестов.
LIOG_MOCK=0

# Товар по умолчанию: PUBG Mobile Code (Global).
LIOG_PRODUCT_ID=66599

# Карта вариаций «номинал UC -> variation_id».
# Источник правды (каталог /products у поставщика сломан — отдаёт 500).
# Формат: номинал:variation_id через запятую.
LIOG_VARIATIONS=60:534124,325:534125,660:534126,1800:534127,3850:534128,8100:534129,16200:534130,24300:534131,32400:534132,40500:534133
