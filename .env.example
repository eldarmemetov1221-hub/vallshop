# ── Общее ────────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните. .env в .gitignore — НЕ коммитить секреты.

# ── Telegram-бот ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
BOT_TOKEN=
# Telegram user id администраторов (через запятую) — им доступна /admin.
ADMIN_IDS=

# ── База данных ──────────────────────────────────────────────────────────────
# По умолчанию локальный SQLite. Для PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/vallshop
DATABASE_URL=sqlite+aiosqlite:///vallshop.db

# ── Витрина / цены ───────────────────────────────────────────────────────────
# Валюта отображения (внутренне всё в USD ≈ USDT).
SHOP_CURRENCY=USDT
# Наценка по умолчанию, % (если у номинала не задана своя цена/наценка).
DEFAULT_MARKUP_PERCENT=0
# Цветные кнопки (style: 🟢success/🔴danger/🔵primary). 1/0.
# Если старый клиент Telegram не отрисовывает цвет — можно выключить (0).
BUTTON_STYLES=1
# Кастом-эмодзи (премиум) на кнопках. Нужен Telegram Premium у владельца бота.
# Если бот без Premium и кнопки не отправляются — выключить (0).
CUSTOM_EMOJI=1

# ── Платёжный провайдер BoltUtil (USDT) ──────────────────────────────────────
BOLT_BASE_URL=https://api.boltutil.com
# API-ключ (заголовок X-Bolt-Key), в кабинете вида bt_live_...
BOLT_API_KEY=
# Webhook Secret из кабинета — ключ HMAC-SHA256 для ВСЕХ запросов и колбэков.
BOLT_SECRET=
# Сеть по умолчанию (если список сетей ниже пуст): TRC20 | ERC20 | BEP20 | POLYGON | SOLANA.
BOLT_NETWORK=TRC20
# Сети на выбор покупателю (через запятую). Для каждой нужен активный
# settlement-кошелёк в кабинете BoltUtil. Пример: TRC20,BEP20,ERC20
BOLT_NETWORKS=TRC20
# Публичный HTTPS-URL сервиса (для notifyUrl вебхука и редиректа).
# Без него вебхук-сервер не поднимается — оплата проверяется кнопкой в боте.
PUBLIC_BASE_URL=
# Порт HTTP-сервера вебхуков.
PORT=8080
# Время жизни счёта, минут (Starter BoltUtil = 30).
PAYMENT_TIMEOUT_MINUTES=30
# Mock-режим платежей (1/0) — без сети и без реальных денег, для разработки.
MOCK_PAYMENTS=0

# ── LioGames (поставщик) ─────────────────────────────────────────────────────
LIOG_BASE_URL=https://distribution.liogames.com/api/v1
LIOG_MEMBER_CODE=M2609247OQFNWJJ8W
LIOG_SECRET=
# LIOG_KEY_ID=
LIOG_SANDBOX=0
LIOG_MOCK=0
LIOG_PRODUCT_ID=66599
LIOG_VARIATIONS=60:534124,325:534125,660:534126,1800:534127,3850:534128,8100:534129,16200:534130,24300:534131,32400:534132,40500:534133
