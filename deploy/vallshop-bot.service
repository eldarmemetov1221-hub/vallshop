[Unit]
Description=VallShop Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Поправьте путь и пользователя под свой сервер.
WorkingDirectory=/opt/vallshop
EnvironmentFile=/opt/vallshop/.env
ExecStart=/opt/vallshop/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
User=vallshop
Group=vallshop

[Install]
WantedBy=multi-user.target
