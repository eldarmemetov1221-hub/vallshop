# nginx-конфиг для вебхука BoltUtil на отдельном поддомене.
# ВАЖНО: это НОВЫЙ server-блок для shop.vallshop.com — он не затрагивает
# другие сайты/боты на этом nginx.
#
# Установка:
#   sudo cp deploy/nginx-shop.conf.example /etc/nginx/sites-available/shop.vallshop.com.conf
#   sudo ln -s /etc/nginx/sites-available/shop.vallshop.com.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Затем выпустить HTTPS-сертификат (сам пропишет TLS в этот конфиг):
#   sudo certbot --nginx -d shop.vallshop.com
#
# На debian/ubuntu, где nginx включает conf.d, можно положить файл в
# /etc/nginx/conf.d/ вместо sites-available/enabled.

server {
    listen 80;
    listen [::]:80;
    server_name shop.vallshop.com;

    # Проксируем только вебхук и healthcheck на контейнер бота (localhost:8080).
    location = /bolt/webhook {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8080;
    }

    # Остальное закрываем.
    location / {
        return 404;
    }
}
